{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // Testfilerna importerar med explicit .ts-ändelse — det krävs av
    // `node --test`, som kör TypeScript direkt utan byggsteg. Flaggan är
    // ofarlig här eftersom noEmit är satt: inget kompileras ut.
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // Testfilerna ingår MED FLIT. De var tidigare exkluderade, vilket betydde
  // att ett test kunde sluta kompilera utan att någon märkte det förrän det
  // kördes — typkontrollen i bygget hoppade över dem helt.
  "exclude": ["node_modules"]
}
