generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Poolad (transaction-mode, pgBouncer) — appens runtime på serverless
  url       = env("DATABASE_URL")
  // Direkt/session-mode — används av migrationer (migrate deploy)
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  FRANCHISEE
}

// Följer FT:s indelning i slutrapporten. Etiketter, färger och ordning bor i
// src/lib/customerTypes.ts — lägg aldrig till ett värde här utan att lägga till
// det där också. OVRIGT står inte i FT:s lista men behövs som uppsamling:
// aggregeringen använder den för okända typer och importen för okända rubriker.
enum CustomerType {
  ALDREBOENDE
  TRAFFPUNKTER
  PENSIONARSFORENING
  FORENING_STOD_HALSA
  OVRIGA_FORENINGAR
  FORSAMLINGSHEM
  PLUS_55
  EGET_ARRANGEMANG
  CAMPINGPLATSER
  MINDRE_FORSALJNING
  OVRIGT
}

enum SeasonType {
  VAR
  HOST
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum Region {
  SE
  FI
  DK
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  role         Role           @default(FRANCHISEE)
  active       Boolean        @default(true)
  districtId   String?
  district     District?      @relation(fields: [districtId], references: [id])
  reports      WeeklyReport[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model District {
  id        String         @id @default(cuid())
  number    Int            @unique
  name      String
  region    Region         @default(SE)
  users     User[]
  customers Customer[]
  reports   WeeklyReport[]
  feeConfig FeeConfig?
  goals     SeasonGoal[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// Standardvillkoren finns i src/lib/fees.ts (STANDARD_FEE_CONFIG) — ändra DÄR först.
// @default-värdena nedan måste hållas i takt för hand; ett test i fees.test.ts
// läser den här filen och larmar om de glider isär. Defaults gäller bara nya
// rader — ändrade villkor kräver en migration för befintliga FeeConfig-rader.
model FeeConfig {
  id            String   @id @default(cuid())
  districtId    String   @unique
  district      District @relation(fields: [districtId], references: [id])
  ftFeePercent  Float    @default(0.075)
  mfFeePercent  Float    @default(0.01)
  // Pengar lagras exakt (öre), satserna ovan är kvoter och förblir Float.
  mfFeeCap      Decimal  @default(6000) @db.Decimal(12, 2)
  vatMultiplier Float    @default(1.25)
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

model Customer {
  id             String      @id @default(cuid())
  name           String
  customerNumber Int         // löpnummer per distrikt, visas som D{distriktsnr}-{customerNumber}
  type           CustomerType
  contactPerson String?
  contactRole   String?
  email         String?
  phone         String?
  address       String?
  // Enbart siffror, utan mellanslag ("12345"). Längden följer distriktets
  // region: 5 för SE/FI, 4 för DK. Se src/lib/postalCode.ts.
  postalCode    String?
  // Postorten. Fri text — det finns ingen uppslagstabell i portalen, så den
  // fylls i för hand precis som postnumret. Hör ihop med postalCode och visas
  // alltid tillsammans med det.
  city          String?
  notes         String?
  // Möteslokalen — var besöket faktiskt äger rum. Föreningar utan egen lokal
  // hyr in sig, och platsen stämmer då inte med adressen ovan. FT fyller i
  // den vid bokningen. Kort fritext (VENUE_MAX_LENGTH i salesMaterial.ts),
  // eftersom den ska rymmas på en rad i kundkortet och i utskick.
  venue         String?
  // Säljmaterial som skickas till kunden inför besöket. Antal i stället för
  // kryssruta + antal: noll betyder att formatet inte skickas, och "har fått
  // A3" blir därmed entydigt (> 0) i stället för två fält som kan säga emot
  // varandra. Digitalt har inget antal men däremot ett vad — därav noteringen.
  //
  // Fälten beskriver vad som SKA skickas, inte vad som skickades vid ett visst
  // besök. Ändras valet gäller det nya även bakåt i analysen.
  postersA3     Int          @default(0)
  postersA4     Int          @default(0)
  digitalMaterial     Boolean @default(false)
  digitalMaterialNote String?
  active        Boolean      @default(true)
  approved      Boolean      @default(false)
  districtId    String
  district      District     @relation(fields: [districtId], references: [id])
  visits        Visit[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([districtId, customerNumber])
}

model Season {
  id        String         @id @default(cuid())
  type      SeasonType
  year      Int
  weekStart Int
  weekEnd   Int
  reports   WeeklyReport[]
  goals     SeasonGoal[]

  @@unique([type, year])
}

// FT:s egna mål per säsong (manuell input), avräknas mot utfallet på Översikt.
// Ett mål per distrikt × säsong. Snitt/besök är ett eget kvalitetsmål, ej uträknat.
model SeasonGoal {
  id                 String   @id @default(cuid())
  districtId         String
  district           District @relation(fields: [districtId], references: [id])
  seasonId           String
  season             Season   @relation(fields: [seasonId], references: [id])
  salesTarget        Float    @default(0)
  visitsTarget       Int      @default(0)
  avgPerVisitTarget  Float    @default(0)
  fashionShowsTarget Int      @default(0)
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([districtId, seasonId])
}

model WeeklyReport {
  id         String       @id @default(cuid())
  districtId String
  district   District     @relation(fields: [districtId], references: [id])
  seasonId   String
  season     Season       @relation(fields: [seasonId], references: [id])
  week       Int
  status     ReportStatus @default(DRAFT)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  visits     Visit[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([districtId, seasonId, week])
}

model Visit {
  id                String       @id @default(cuid())
  reportId          String
  report            WeeklyReport @relation(fields: [reportId], references: [id])
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id])
  numberOfCustomers Int          @default(0)
  // Belopp i kronor med öresprecision — aldrig Float (se src/lib/fees.ts).
  sales             Decimal      @default(0) @db.Decimal(12, 2)
  isFashionShow     Boolean      @default(false)
  fashionShowSales  Decimal      @default(0) @db.Decimal(12, 2)
  isHangerShow      Boolean      @default(false)
  // REA-besök. Fristående från visningstypen ovan — ett reabesök kan vara
  // antingen modevisning eller galge. FT återvänder till sina bästa ställen
  // med rea, och de besöken har ett annat snittkvitto än de ordinarie; utan
  // den här flaggan drar de ned statistiken just på de kunder som går bäst.
  isSale            Boolean      @default(false)
  ftFee             Decimal      @default(0) @db.Decimal(12, 2)
  mfFee             Decimal      @default(0) @db.Decimal(12, 2)
  mfFeeAccumulated  Decimal      @default(0) @db.Decimal(12, 2)
  totalToPay        Decimal      @default(0) @db.Decimal(12, 2)
  comment           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  userEmail String?
  details   String?
  createdAt DateTime @default(now())

  // Login-spärren räknar LOGIN_FAILED per e-post inom ett tidsfönster
  @@index([userEmail, action, createdAt])
  // Admin-loggvyn hämtar senaste N sorterat på tid
  @@index([createdAt])
}
